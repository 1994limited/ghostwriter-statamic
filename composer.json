{
    "name": "1994/ghostwriter-statamic",
    "description": "Learns a site's tone of voice and image style from what it has published, then drafts new entries in that voice from a short brief and a conversation, finds or makes images to match (or licenses stock photos from your own account), walks you through finishing each page, and plans what the site is missing.",
    "type": "statamic-addon",
    "license": "proprietary",
    "keywords": [
        "statamic",
        "statamic-addon",
        "ai",
        "writing",
        "content",
        "claude",
        "openai",
        "gemini"
    ],
    "homepage": "https://github.com/1994limited/ghostwriter-statamic",
    "support": {
        "issues": "https://github.com/1994limited/ghostwriter-statamic/issues",
        "source": "https://github.com/1994limited/ghostwriter-statamic"
    },
    "authors": [
        {
            "name": "1994",
            "email": "hello@1994.co.uk",
            "homepage": "https://1994.co.uk"
        }
    ],
    "autoload": {
        "psr-4": {
            "NineteenNinetyFour\\Ghostwriter\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "NineteenNinetyFour\\Ghostwriter\\Tests\\": "tests",
            "NineteenNinetyFour\\Ghostwriter\\Core\\Tests\\Contracts\\": "vendor/1994/ghostwriter-core/tests/Contracts/"
        }
    },
    "require": {
        "php": "^8.3",
        "ext-gd": "*",
        "1994/ghostwriter-core": "^1.6",
        "guzzlehttp/guzzle": "^7.8|^8.0",
        "guzzlehttp/psr7": "^2.6|^3.0",
        "league/commonmark": "^2.4",
        "statamic/cms": "^6.30",
        "symfony/yaml": "^7.0 || ^8.0"
    },
    "require-dev": {
        "laravel/pint": "^1.20",
        "orchestra/testbench": "^10.0|^11.0",
        "phpunit/phpunit": "^12.0"
    },
    "suggest": {
        "ext-imagick": "Sends smaller copies of images to the model."
    },
    "extra": {
        "statamic": {
            "name": "Ghostwriter",
            "description": "Learns your tone of voice and image style, drafts entries in your voice, finds, makes or licenses images, walks you through finishing each page, and plans what the site is missing.",
            "developer": "1994",
            "developer-url": "https://1994.co.uk"
        },
        "laravel": {
            "providers": [
                "NineteenNinetyFour\\Ghostwriter\\ServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
